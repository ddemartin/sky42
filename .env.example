# Copia in .env e adatta. Il file .env non sta in git.

# Fuso per l'interfaccia. Nel database tutto è UTC e JD: questo serve solo a
# leggere le notti degli osservatori in ora locale.
TZ=Europe/Rome

# Indirizzo su cui pubblicare la porta 8242 sull'host.
#   127.0.0.1   solo da questa macchina (default, sicuro)
#   100.x.y.z   l'indirizzo Tailscale DI QUESTA macchina: raggiungibile dai
#               peer della tailnet e non dalla rete locale
# Mai 0.0.0.0: sky42 non ha autenticazione, e sarebbe esposto anche al Wi-Fi
# di casa. Il giorno di `tailscale funnel` l'autenticazione arriva prima.
# SKY42_BIND_IP=100.x.y.z

# sky42 è un ospite: il Mac mini fa girare anche brain42 e stock42.
SKY42_MAX_WORKERS=2
SKY42_NICE=10
SKY42_LOAD_LIMIT=1.0
